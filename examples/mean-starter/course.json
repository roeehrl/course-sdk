      "accessibility": { "keyboard": true, "reducedMotion": true, "textAlternative": "A staff member reads the explanation and confirms each finding." },
      "license": "Apache-2.0"
    }
  ],
  "visuals": [
    {
      "id": "dot-plot",
      "rendererId": "dot-plot-renderer",
      "platforms": ["web"],
      "state": { "fourth": 30, "show": "mean" },
      "scene": {},
      "layouts": { "compact": { "stack": true }, "expanded": { "columns": 2 } },
      "timeline": { "durationMs": 1000, "seekable": false, "cues": [] },
      "accessibility": { "description": "A number line from 0 to 100 with a dot for each reading and a marker at their mean. Moving the fourth reading moves the mean a quarter as far.", "reducedMotion": {} },
      "referenceChecks": [],
      "requiredFeatures": ["panes"],
      "interactions": [
        {
          "id": "move-fourth",
          "kind": "drag",
          "target": "fourth-dot",
          "label": "Drag the fourth reading",
          "binding": { "state": "fourth", "range": { "min": 0, "max": 100, "step": 5 } },
          "alternative": { "kind": "keyboard", "keys": ["ArrowLeft", "ArrowRight"] }
        },
        {
          "id": "choose-marker",
          "kind": "tap",
          "target": "marker",
          "label": "Choose what to mark",
          "binding": { "state": "show", "values": ["mean", "sum"], "labels": ["Mark the mean", "Mark the sum"] },
          "alternative": { "kind": "control" }
        }
      ],
      "panes": [
        { "id": "readings", "kind": "table", "title": "Readings", "columns": ["Reading", "Value"], "rows": [[1, 10], [2, 20], [3, 60], [4, { "state": "fourth" }]] },
        { "id": "mean-formula", "kind": "formula", "title": "The mean", "tex": "\\bar{x} = \\frac{x_1 + x_2 + x_3 + x_4}{4}", "label": "x bar equals the sum of the four readings divided by 4" }
      ]
    }
  ],
