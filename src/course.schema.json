{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:course-core:schema:course:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "summary", "locale", "platforms", "objectives", "chapters", "assessments", "gates", "extensions", "visuals", "media", "sources", "policy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "title": { "$ref": "#/$defs/shortText" },
    "summary": { "$ref": "#/$defs/text" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 64 },
    "platforms": { "$ref": "#/$defs/platforms" },
    "objectives": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/objective" } },
    "chapters": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/chapter" } },
    "assessments": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/assessment" } },
    "gates": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/gate" } },
    "extensions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/extension" } },
    "visuals": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/visual" } },
    "media": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/media" } },
    "sources": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/source" } },
    "policy": { "$ref": "#/$defs/policy" },
    "placement": { "$ref": "#/$defs/placement" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 300 },
    "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "ids": { "type": "array", "uniqueItems": true, "maxItems": 2000, "items": { "$ref": "#/$defs/id" } },
    "platforms": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["web", "ios", "android"] } },
    "state": { "type": "object" },
    "objective": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "prerequisites"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" },
        "prerequisites": { "$ref": "#/$defs/ids" }, "critical": { "type": "boolean" }, "placeable": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "url", "reviewedAt"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/shortText" }, "url": { "type": "string", "format": "uri", "maxLength": 4096 }, "reviewedAt": { "type": "string", "format": "date-time" }, "license": { "$ref": "#/$defs/shortText" } }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["mode", "existingMaterialAccess"],
      "properties": {
        "mode": { "enum": ["bounded", "open_ended"] },
        "targetDate": { "type": "string", "format": "date-time" },
        "hardDeadline": { "type": "string", "format": "date-time" },
        "window": {
          "type": "object", "additionalProperties": false, "required": ["calendarDays", "timeZone", "anchor", "pauseRule"],
          "properties": { "calendarDays": { "type": "integer", "minimum": 1, "maximum": 36500 }, "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 }, "anchor": { "enum": ["enrollment_started", "scope_assigned", "scope_started"] }, "pauseRule": { "enum": ["never", "approved_only"] } }
        },
        "work": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": { "additionalEpisodes": { "type": "integer", "minimum": 0 }, "additionalMinutes": { "type": "integer", "minimum": 0 }, "remediationCyclesPerConcept": { "type": "integer", "minimum": 0 } }
        },
        "extensions": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled", "calendarDays", "maxGrants", "maxDaysPerGrant", "learnerAcceptanceRequired"],
          "properties": { "enabled": { "type": "boolean" }, "calendarDays": { "type": "integer", "minimum": 0, "maximum": 36500 }, "maxGrants": { "type": "integer", "minimum": 0, "maximum": 1000 }, "maxDaysPerGrant": { "type": "integer", "minimum": 0, "maximum": 36500 }, "learnerAcceptanceRequired": { "const": true } }
        },
        "existingMaterialAccess": { "enum": ["read_only", "closed"] }
      }
    },
    "block": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["id", "type", "markdown"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "text" }, "markdown": { "$ref": "#/$defs/text" }, "sourceRefs": { "$ref": "#/$defs/ids" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "type", "assessmentId"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "assessment" }, "assessmentId": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "type", "visualId"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "visual" }, "visualId": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "type", "mediaId", "required"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "media" }, "mediaId": { "$ref": "#/$defs/id" }, "required": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "type", "extensionId", "configuration"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "activity" }, "extensionId": { "$ref": "#/$defs/id" }, "configuration": { "$ref": "#/$defs/state" } } }
      ]
    },
    "episode": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "objectiveIds", "blocks"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/shortText" }, "objectiveIds": { "$ref": "#/$defs/ids", "type": "array", "minItems": 1 }, "blocks": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/block" } }, "gateId": { "$ref": "#/$defs/id" }, "policy": { "$ref": "#/$defs/policy" } }
    },
    "chapter": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "episodes"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/shortText" }, "summary": { "$ref": "#/$defs/text" }, "episodes": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/episode" } }, "policy": { "$ref": "#/$defs/policy" } }
    },
    "assessment": {
      "type": "object", "required": ["id", "objectiveIds", "prompt", "familyId", "type", "grading"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "objectiveIds": { "$ref": "#/$defs/ids", "type": "array", "minItems": 1 }, "prompt": { "$ref": "#/$defs/text" }, "familyId": { "$ref": "#/$defs/id" }, "type": { "enum": ["choice", "numeric", "rubric", "code"] } },
      "oneOf": [
        { "properties": { "type": { "const": "choice" }, "options": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/text" } } } }, "grading": { "type": "object", "additionalProperties": false, "required": ["correctOptionId", "explanation"], "properties": { "correctOptionId": { "$ref": "#/$defs/id" }, "explanation": { "$ref": "#/$defs/text" } } } }, "required": ["options"] },
        { "properties": { "type": { "const": "numeric" }, "grading": { "type": "object", "additionalProperties": false, "required": ["expected", "absoluteTolerance", "explanation"], "properties": { "expected": { "type": "number" }, "absoluteTolerance": { "type": "number", "minimum": 0 }, "explanation": { "$ref": "#/$defs/text" } } } } },
        { "properties": { "type": { "const": "rubric" }, "grading": { "type": "object", "additionalProperties": false, "required": ["evaluatorId", "rubric"], "properties": { "evaluatorId": { "$ref": "#/$defs/id" }, "rubric": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["id", "description", "required"], "properties": { "id": { "$ref": "#/$defs/id" }, "description": { "$ref": "#/$defs/text" }, "required": { "type": "boolean" } } } } } } } },
        { "properties": { "type": { "const": "code" }, "language": { "$ref": "#/$defs/shortText" }, "starterCode": { "type": "string", "maxLength": 100000 }, "grading": { "type": "object", "additionalProperties": false, "required": ["evaluatorId", "fixtureRef"], "properties": { "evaluatorId": { "$ref": "#/$defs/id" }, "fixtureRef": { "$ref": "#/$defs/shortText" } } } }, "required": ["language", "starterCode"] }
      ],
      "unevaluatedProperties": false
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objectiveIds", "assessmentIds", "minimumIndependentFamilies", "requireAllObjectives"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "objectiveIds": { "$ref": "#/$defs/ids", "type": "array", "minItems": 1 }, "assessmentIds": { "$ref": "#/$defs/ids" }, "minimumIndependentFamilies": { "type": "integer", "minimum": 1, "maximum": 100 }, "conversationalEvaluatorId": { "$ref": "#/$defs/id" }, "requireAllObjectives": { "type": "boolean" } }
    },
    "placement": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "learnerMayDecline", "objectiveIds", "assessmentIds", "protectedEpisodeIds", "maxItems"],
      "properties": { "enabled": { "type": "boolean" }, "learnerMayDecline": { "const": true }, "objectiveIds": { "$ref": "#/$defs/ids" }, "assessmentIds": { "$ref": "#/$defs/ids" }, "protectedEpisodeIds": { "$ref": "#/$defs/ids" }, "maxItems": { "type": "integer", "minimum": 1, "maximum": 1000 } }
    },
    "extension": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "platforms", "execution", "capabilities", "entrypoint", "integrity", "accessibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/version" }, "platforms": { "$ref": "#/$defs/platforms" }, "execution": { "enum": ["declarative", "sandboxed_web", "server", "bundled_native"] },
        "capabilities": { "$ref": "#/$defs/ids" }, "entrypoint": { "type": "string", "minLength": 1, "maxLength": 300 }, "integrity": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
        "accessibility": { "type": "object", "additionalProperties": false, "required": ["keyboard", "reducedMotion", "textAlternative"], "properties": { "keyboard": { "type": "boolean" }, "reducedMotion": { "type": "boolean" }, "textAlternative": { "$ref": "#/$defs/text" } } }
      }
    },
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rendererId", "platforms", "state", "scene", "layouts", "timeline", "accessibility", "referenceChecks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "rendererId": { "$ref": "#/$defs/id" }, "platforms": { "$ref": "#/$defs/platforms" }, "state": { "$ref": "#/$defs/state" }, "scene": { "$ref": "#/$defs/state" },
        "layouts": { "type": "object", "additionalProperties": false, "required": ["compact", "expanded"], "properties": { "compact": { "$ref": "#/$defs/state" }, "expanded": { "$ref": "#/$defs/state" } } },
        "timeline": { "type": "object", "additionalProperties": false, "required": ["durationMs", "seekable", "cues"], "properties": { "durationMs": { "type": "integer", "minimum": 0, "maximum": 3600000 }, "seekable": { "type": "boolean" }, "cues": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": false, "required": ["atMs", "event"], "properties": { "atMs": { "type": "integer", "minimum": 0 }, "event": { "$ref": "#/$defs/id" } } } } } },
        "accessibility": { "type": "object", "additionalProperties": false, "required": ["description", "reducedMotion"], "properties": { "description": { "$ref": "#/$defs/text" }, "reducedMotion": { "$ref": "#/$defs/state" } } },
        "referenceChecks": { "$ref": "#/$defs/ids" }
      }
    },
    "media": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "sourceRef", "url", "review", "alternativeMarkdown", "generated"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["youtube", "video", "image", "audio"] }, "sourceRef": { "$ref": "#/$defs/id" }, "url": { "type": "string", "format": "uri", "maxLength": 4096 }, "review": { "enum": ["unreviewed", "reviewed", "rejected"] }, "alternativeMarkdown": { "$ref": "#/$defs/text" }, "generated": { "type": "boolean" } }
    }
  }
}
