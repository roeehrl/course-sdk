            "type": "variable",
            "name": "a"
          },
          "right": {
            "type": "variable",
            "name": "b"
          }
        },
        "maxNodes": 16,
        "maxDepth": 8,
        "maxAbsoluteValue": 1000,
        "referenceCheck": {
          "verifierId": "ordering-verifier",
          "verifierVersion": "1.0.0",
